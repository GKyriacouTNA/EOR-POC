# Source this file before using the AWS CLI against the local Floci emulator:
#   set -a && . ./.env.example && set +a
#
# These are deliberately dummy credentials. AWS tooling requires non-empty
# credentials even though Floci does not contact AWS or validate these values.
# Never put real AWS credentials in this repository or this file.

# Makes compatible AWS tools call the Floci HTTP endpoint on this machine.
export AWS_ENDPOINT_URL=http://localhost:4566

# Floci uses this region when it returns AWS-shaped ARNs and resource metadata.
export AWS_DEFAULT_REGION=us-east-1

# Floci maps non-12-digit access keys, such as `test`, to its default local
# account (000000000000). This keeps all PoC resources in one local account.
export AWS_ACCESS_KEY_ID=test
export AWS_SECRET_ACCESS_KEY=test

# Step 3 local RDS PostgreSQL settings. These are deliberately predictable PoC
# values, not credentials for any external system. Production credentials will
# use an appropriate secrets-management approach instead.
export LOCAL_RDS_INSTANCE_ID=metadata-history-db
export LOCAL_RDS_DATABASE=metadata_history
export LOCAL_RDS_USERNAME=metadata_admin
export LOCAL_RDS_PASSWORD=local-poc-password
